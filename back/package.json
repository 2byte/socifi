{
  "name": "socifi-back",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:watch": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:migrate": "bun run src/db/migrate.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/websocket": "^0.2.8",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.9.3"
  }
}
